// context: timeframe=daily market=mcx
// planted: ai 15 The channel includes the current bar, so the close can never break it
//
// Meant as a breakout of the earlier bars' high.

_SECTION_BEGIN("Channel breakout");

EntryLen = Param("Entry channel", 20, 10, 100, 1);
ExitLen = Param("Exit channel", 10, 5, 50, 1);
AtrMultiple = Param("ATR multiple", 3, 1, 6, 0.5);

SetTradeDelays(1, 1, 1, 1);
SetPositionSize(10, spsPercentOfEquity);

UpperChannel = HHV(High, EntryLen);
LowerChannel = LLV(Low, ExitLen);

Buy = Close > UpperChannel;
Sell = Close < LowerChannel;
BuyPrice = Open;
SellPrice = Open;

ApplyStop(stopTypeTrailing, stopModePoint, AtrMultiple * ATR(14), True, True);

Buy = ExRem(Buy, Sell);
Sell = ExRem(Sell, Buy);

Plot(Close, "Close", colorDefault, styleCandle);
Plot(UpperChannel, "Entry channel", colorGreen, styleLine);
Plot(LowerChannel, "Exit channel", colorRed, styleLine);
PlotShapes(Buy * shapeUpArrow, colorGreen, 0, Low);
PlotShapes(Sell * shapeDownArrow, colorRed, 0, High);

_SECTION_END();
