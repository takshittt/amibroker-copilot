_SECTION_BEGIN("Bollinger bands");

Length = Param("Length", 20, 5, 100, 1);
Width = Param("Width", 2, 0.5, 4, 0.25);
BandColour = ParamColor("Band colour", colorBlue);

Middle = MA(Close, Length);
Upper = BBandTop(Close, Length, Width);
Lower = BBandBot(Close, Length, Width);

Plot(Close, "Close", colorDefault, styleCandle);
Plot(Middle, "Middle", BandColour, styleDashed);
Plot(Upper, "Upper band", BandColour, styleLine);
Plot(Lower, "Lower band", BandColour, styleLine);

_SECTION_END();
