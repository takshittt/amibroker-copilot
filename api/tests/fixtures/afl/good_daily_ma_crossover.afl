// context: timeframe=daily market=nse_eq
// expect: none
//
// Daily moving-average crossover on an NSE stock, trading at the next open.

_SECTION_BEGIN("MA crossover");

SetTradeDelays(1, 1, 1, 1);
SetPositionSize(10, spsPercentOfEquity);

FastLen = Param("Fast average", 20, 5, 100, 1);
SlowLen = Param("Slow average", 50, 10, 300, 1);

Fast = MA(Close, FastLen);
Slow = MA(Close, SlowLen);

Buy = Cross(Fast, Slow);
Sell = Cross(Slow, Fast);
BuyPrice = Open;
SellPrice = Open;

Buy = ExRem(Buy, Sell);
Sell = ExRem(Sell, Buy);

Plot(Close, "Close", colorDefault, styleCandle);
Plot(Fast, "Fast", colorGreen, styleLine);
Plot(Slow, "Slow", colorRed, styleLine);
PlotShapes(Buy * shapeUpArrow, colorGreen, 0, Low);
PlotShapes(Sell * shapeDownArrow, colorRed, 0, High);

_SECTION_END();
