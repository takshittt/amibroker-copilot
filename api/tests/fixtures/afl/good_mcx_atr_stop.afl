// context: timeframe=15min market=mcx
// expect: none
//
// MCX crude oil, 15-minute bars: breakout of the earlier 20-bar high with
// an ATR trailing stop from ApplyStop, flat before the evening close.

LastEntryTime = ParamTime("Last entry", "22:30");
ExitTime = ParamTime("Exit time", "23:15");
Lookback = Param("Breakout bars", 20, 5, 100, 1);
AtrMult = Param("ATR multiple", 2, 1, 5, 0.5);

SetTradeDelays(0, 0, 0, 0);

tn = TimeNum();
Level = Ref(HHV(High, Lookback), -1);

Buy = High > Level AND tn <= LastEntryTime;
BuyPrice = Max(Open, Level);
Sell = tn >= ExitTime;
SellPrice = Close;

ApplyStop(stopTypeTrailing, stopModePoint, AtrMult * ATR(14), True);

Buy = ExRem(Buy, Sell);
Sell = ExRem(Sell, Buy);

Filter = Buy;
AddColumn(Level, "Breakout level");
AddColumn(ATR(14), "ATR");
