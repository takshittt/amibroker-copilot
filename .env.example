# Copy to .env and fill in. Never commit .env.
# Write each line as NAME=value, with no quotes: the Makefile reads this file.

OPENAI_API_KEY=

# The exact OpenAI model ids, from your account's model list. There are no
# defaults. The design names "GPT-6.1 Sol" (strong) and "GPT-6 Luna" (cheap).
STRONG_MODEL=
CHEAP_MODEL=

# US dollars for a million tokens, used to report what a run cost.
# Left empty, the cost is reported as unknown.
STRONG_PRICE_IN=
STRONG_PRICE_OUT=
CHEAP_PRICE_IN=
CHEAP_PRICE_OUT=

# Pipeline limits. These are the defaults.
MAX_ATTEMPTS=3
RERANK_KEEP=10
MAX_REQUEST_CHARS=4000
REDIS_URL=

# Postgres with the pgvector extension. Left empty, the Makefile uses the
# local one from docker-compose.yml.
DATABASE_URL=
# Set to false when connecting through a pooler in transaction mode (Supabase).
DB_PREPARED_STATEMENTS=true

# Embeddings. The size must match the vector column in api/migrations.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# At least 32 random bytes each. Set the same values on the web and API sides.
# The API refuses to start without them. One way to make one:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
BFF_SHARED_SECRET=

# API limits. These are the defaults, except the spend cap, which is off
# until set. A spend cap needs all four prices above.
DAILY_QUOTA=20
DAILY_SPEND_CAP_USD=
QUOTA_TIMEZONE=Asia/Kolkata
TOKEN_DAYS=7
LOGIN_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=900

# Website (BFF). The address of the API as the website's server reaches it,
# never shown to browsers. JWT_SECRET and BFF_SHARED_SECRET above must be
# the same on both sides.
API_URL=http://127.0.0.1:8000
# Shown on the login page for password resets.
SUPPORT_EMAIL=
